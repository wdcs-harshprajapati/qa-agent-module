{
  "name": "qa-automation-suite",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup": "playwright install chromium firefox webkit",
    "test": "playwright test",
    "test:headless": "cross-env HEADLESS=true playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:positive": "playwright test -g \"Positive Cases\"",
    "test:negative": "playwright test -g \"Negative Cases\"",
    "test:failed": "playwright test --last-failed",
    "test:desktop": "cross-env QA_PROJECTS=\"Chrome,Firefox,Safari\" playwright test",
    "test:mobile": "cross-env QA_PROJECTS=\"Mobile Chrome,Mobile Safari\" playwright test",
    "test:all-browsers": "cross-env QA_PROJECTS=all playwright test",
    "test:visual": "playwright test --grep @visual",
    "test:update-baselines": "playwright test --grep @visual --update-snapshots=all",
    "test:perf": "playwright test --grep @perf",
    "test:api": "playwright test --grep @api",
    "test:mobile-ux": "cross-env QA_PROJECTS=\"Mobile Chrome,Mobile Safari\" playwright test --grep @mobile-ux",
    "test:browserstack": "cross-env QA_MOBILE_MODE=browserstack QA_PROJECTS=\"Mobile Chrome,Mobile Safari\" browserstack-node-sdk playwright test",
    "test:burp": "cross-env USE_BURP=true playwright test",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.0",
    "typescript": "^5.7.0"
  }
}
