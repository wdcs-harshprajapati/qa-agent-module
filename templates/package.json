{
  "name": "qa-automation-suite",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup": "playwright install chromium webkit",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:positive": "playwright test -g \"Positive Cases\"",
    "test:negative": "playwright test -g \"Negative Cases\"",
    "test:burp": "cross-env USE_BURP=true playwright test",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.0",
    "typescript": "^5.7.0"
  }
}
