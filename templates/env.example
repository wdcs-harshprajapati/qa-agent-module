# Copy this file to .env and fill in the values. .env is git-ignored.
BASE_URL=
# Add only the variables this suite uses (e.g. TEST_USER, TEST_PASSWORD).

# Run settings (set by /qa:run-qa after plan approval; edit to change later runs)
# Browsers: comma-separated, or "all". Chrome, Firefox, Safari, Mobile Chrome (Galaxy S25 Ultra), Mobile Safari (iPhone 16 Pro)
QA_PROJECTS=all
# false = visible browser window (default), true = no window
HEADLESS=false
# on | only-on-failure | off
SCREENSHOT=on
# on | retain-on-failure | off
VIDEO=on
