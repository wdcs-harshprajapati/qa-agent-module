# Copy this file to .env and fill in the values. .env and .env.* are git-ignored.
BASE_URL=
# Add only the variables this suite uses (e.g. TEST_USER, TEST_PASSWORD).

# Environments (only when the app has more than one). Each .env.<name> file holds that
# environment's BASE_URL and credentials; QA_ENV picks the default one.
# One-off run against another environment: npx cross-env QA_ENV=staging playwright test
# QA_ENV=staging

# Run settings (set by /qa:run-qa after plan approval; edit to change later runs)
# Browsers: comma-separated, or "all". Chrome, Firefox, Safari, Mobile Chrome, Mobile Safari
QA_PROJECTS=all
# false = visible browser window (default), true = no window
HEADLESS=false
# on | only-on-failure | off
SCREENSHOT=on
# on | retain-on-failure | off
VIDEO=on
# Mobile browsers: emulation (default screen sizes) | android-emulator (Android SDK, adb) | browserstack (real devices)
QA_MOBILE_MODE=emulation
# android-emulator only: pick one device when several are attached (see `adb devices`)
# ANDROID_SERIAL=emulator-5554
# Number of run folders kept in reports/runs/
QA_KEEP_RUNS=20

# browserstack only (type these yourself)
# BROWSERSTACK_USERNAME=
# BROWSERSTACK_ACCESS_KEY=

# MailSlurp only, for OTP / verification emails (type these yourself)
# MAILSLURP_API_KEY=
# MAILSLURP_INBOX_ID=
